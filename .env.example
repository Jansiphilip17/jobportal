# ─── Core ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (Local MySQL) ──────────────────────────────────
DB_NAME=jobportal_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306

# ─── Database (Render/Production PostgreSQL) ────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# (set this automatically by Render — do NOT set DB_* above when using this)

# ─── Email ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=noreply@jobportal.com
